    "text_transform": "lowercase char_wb TF-IDF ngrams 3-5, min_df=2, max_features=60000",
    "numeric_transform": "StandardScaler(with_mean=False) fitted on training rows",
    "missing_value_policy": "missing text becomes empty text; numeric coercion failures and missing values become zero",
    "excluded_leakage_fields": ["external cross-reference identifiers", "RXNdb identifiers"]
  },
  "training_semantics": {
    "method": "25-member bagged working-negative PU heuristic with class-weight-balanced liblinear logistic regression",
    "positive_label": "label 1: curated or database-cross-referenced reaction",
    "zero_label": "label 0: unlabeled candidate sampled as a temporary working negative, never a confirmed negative",
    "estimand": "reference-likeness ranking, not probability of biochemical truth",
    "split_strategy": "connected-group split across protein homology, normalized stoichiometry, substrate structure, and reaction identifiers",
    "decision_threshold": {"source": "development split", "purpose": "select a threshold targeting labeled-positive recall; value absent from the legacy snapshot"},
    "ensemble": {"members": 25, "positive_rows_per_member": 1584, "sampled_unlabeled_rows_per_member": 950, "negative_positive_ratio": 0.6, "aggregation": "mean member score", "assumption": "positive selection may be biased/non-SCAR; no class-prior correction"}
  },
