      {"name": "enzyme_evidence_rows_num", "dtype": "float64", "semantic": "enzyme evidence row count"},
      {"name": "reactant_count", "dtype": "int64", "semantic": "reactant identifier count"},
      {"name": "product_count", "dtype": "int64", "semantic": "product identifier count"},
      {"name": "stoich_metabolite_count", "dtype": "int64", "semantic": "metabolites in parsed stoichiometry"},
