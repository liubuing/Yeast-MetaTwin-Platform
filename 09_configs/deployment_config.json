  "models": {
    "yeast_gem": "Data/model/yeast-GEM.yml",
    "yeast_metatwin": "Data/model/Yeast-MetaTwin.yml",
    "yeast_metatwin_lipid": "Data/model/Yeast-MetaTwin-lipid.yml"
  },
  "species_profiles": "09_configs/species/",
  "cross_species_modules": {
    "species_profile": "08_runtime/species_profile.py",
    "load_gem_multispecies": "08_runtime/load_gem_multispecies.py",
    "esm2_encode": "08_runtime/esm2_encode.py",
    "id_mapping_bridge": "08_runtime/id_mapping_bridge.py",
    "multitask_model": "08_runtime/multitask_model.py",
    "omics_constrain": "08_runtime/omics_constrain.py",
    "acquisition": "08_runtime/acquisition.py",
    "cross_species_workflow": "08_runtime/cross_species_workflow.py"
  },
  "audit_outputs": {
    "pathway_audit_md": "audit/pathway_prediction_audit.md",
